# Chép thành .env cạnh docker-compose.yml rồi điền. Không commit .env (đã có trong .gitignore).
# Chú thích luôn ở dòng riêng: compose coi phần sau dấu = là giá trị, kể cả "# …" khi giá trị để trống.

# Caddy xin chứng chỉ HTTPS cho tên miền này
DOMAIN=game.example.com
# Mật khẩu Postgres: chuỗi ngẫu nhiên dài (openssl rand -base64 32)
DB_PASSWORD=
# Origin khác được gọi API/socket, cách nhau dấu phẩy (vd. https://html.itch.zone)
ORIGINS=
# ≥ 24 ký tự: bật /api/admin/* (thống kê, thư, cấm chat); để trống là tắt
ADMIN_TOKEN=
# IP được gọi /api/admin qua Caddy, cách nhau dấu cách (vd. 203.0.113.7/32)
ADMIN_IPS=127.0.0.1/8
# Chợ giữa người chơi: off để tắt khi bị lạm dụng
MARKET=on
# Số ngày giữ bản pg_dump
BACKUP_KEEP_DAYS=14
# Web Push: npx web-push generate-vapid-keys; để trống là không có thông báo đẩy
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
