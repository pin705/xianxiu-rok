{
  "name": "rok",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env tools/dev.ts",
    "dev": "npm run dev -w @rok/client",
    "build": "npm run build -w @rok/client",
    "test": "node --env-file-if-exists=.env --test architecture.test.ts 'packages/*/*.test.ts' 'apps/*/*.test.ts'",
    "check": "tsc && npm run check -ws --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "sim": "node packages/rules/simulate.ts",
    "e2e": "node --env-file-if-exists=.env apps/client/e2e.ts",
    "fonts": "npm run fonts -w @rok/client",
    "package": "npm run build && rm -f release.zip && cd apps/client/dist && zip -qr ../../../release.zip . && echo 'release.zip: tải lên itch.io (HTML, chơi trên trình duyệt)'",
    "server": "npm run dev -w @rok/server",
    "db": "docker compose -f apps/server/deploy/compose.dev.yml up -d --wait",
    "load": "node --env-file-if-exists=.env apps/server/load.ts",
    "art": "tools/art/.venv/bin/python tools/art/make.py",
    "art:export": "node tools/art/export.ts",
    "art:spec": "node tools/art/spec.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^7.0.2"
  }
}
