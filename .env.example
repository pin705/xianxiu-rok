# Chép thành .env (đã gitignore). npm start/test/e2e/load, npm run server và play.ts tự nạp file này.
# Dòng bị comment = dùng giá trị mặc định ghi bên cạnh.

# ── Database ─────────────────────────────────────────────────────────────
# Đặt thì npm start bỏ qua Docker. Test/e2e/play tạo database tạm → user cần quyền CREATEDB.
DATABASE_URL=postgres://user:pass@host:5432/rok
# E2E_DATABASE_URL=                 # riêng cho e2e; mặc định = DATABASE_URL

# ── Server (apps/server/src/config.ts) ───────────────────────────────────
# NODE_ENV=development              # development | production | test
# PORT=8787                         # ĐỪNG đặt ở đây: Vite cũng đọc PORT (5173) → hai bên giành cổng
# HOST=0.0.0.0
# NODE_PATH=/socket.io              # nhiều node sau Caddy: /n1/socket.io, /n2/socket.io…
# ORIGINS=                          # origin khác được gọi API/socket, cách nhau dấu phẩy (itch.io…)
# TRUST_PROXY=false
# ALLOW_WARP=false                  # công cụ dev/e2e: tua giờ, đặt state; cấm ở production
# LIMITS=true                       # false khi load test
# COMMIT_MS=30                      # cửa sổ commit gộp (0–1000)
# SYNC_COMMIT=true                  # false: bớt fsync, rủi ro mất ~200 ms thao tác nếu Postgres sập
# WORLD_CAP=300
# REBALANCE=true
# MARKET=true                       # chợ giữa người chơi
# ADMIN_TOKEN=                      # ≥24 ký tự; bật /api/admin/* (header x-admin-token)
# LOG_LEVEL=info                    # fatal | error | warn | info | debug | trace | silent

# Web Push (npx web-push generate-vapid-keys); không đặt thì không có thông báo đẩy
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@localhost

# ── Client / công cụ ─────────────────────────────────────────────────────
# ROK_SERVER=http://127.0.0.1:8787  # Vite dev proxy trỏ về server này
# VITE_SERVER_URL=                  # bản build gọi server khác origin (itch.io); rỗng = cùng origin
# CHROME=                           # đường dẫn Chrome cho e2e/play nếu không ở chỗ mặc định
# PLAY_DIR=                         # thư mục làm việc của play.ts (mặc định $TMPDIR/rok-play)

# ── Art (tools/art) ──────────────────────────────────────────────────────
IMG_STUDIO_KEY=
