{
  // Hàng rào chống code bẩn dần. Chạy: npm run lint (CI chạy trước test).
  // Ngưỡng đếm dòng bỏ qua dòng trống và comment. max-lines-per-function đếm cả hàm con bên trong,
  // nên closure kiểu module (createNet, plugin HTTP, bot.turn) có ngưỡng riêng ở overrides.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/dist/**", "apps/server/drizzle/**"],
  "rules": {
    "no-sequences": ["error", { "allowInParentheses": false }],
    "no-unused-expressions": "error",
    "no-shadow": ["error", { "ignoreOnInitialization": true }],
    "eqeqeq": "error",
    "max-depth": ["error", 4],
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["error", { "max": 100, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // dữ liệu / tranh vẽ tay / kịch bản test: dài vì nội dung, không phải vì logic
      "files": [
        "**/*.test.ts",
        "apps/client/e2e.ts",
        "apps/client/src/lab.ts",
        "packages/i18n/locales/*.ts",
        "packages/rules/data.ts",
        "packages/art/*.ts"
      ],
      "rules": { "max-lines": "off", "max-lines-per-function": "off" }
    },
    // Mức trần của các file lớn hiện có: chỉ được nhỏ đi. Thêm tính năng mà vượt trần thì tách file
    // (gợi ý: home.ts → sky/water/buildings, battle.ts → skills).
    {
      "files": ["apps/client/src/world/home.ts"],
      "rules": { "max-lines": ["error", { "max": 1100, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      "files": ["apps/client/src/world/battle.ts"],
      "rules": { "max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      "files": ["apps/client/src/App.svelte"],
      "rules": { "max-lines": ["error", { "max": 450, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      "files": ["apps/client/src/net.ts"],
      "rules": { "max-lines-per-function": ["error", { "max": 340, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      "files": ["packages/rules/bot.ts"],
      "rules": { "max-lines-per-function": ["error", { "max": 180, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      "files": ["packages/rules/world/raid.ts"],
      "rules": { "max-lines-per-function": ["error", { "max": 140, "skipBlankLines": true, "skipComments": true }] }
    }
  ]
}
